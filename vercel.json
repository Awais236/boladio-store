{
  "version": 2,
  "outputDirectory": "web/dist",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm --workspace web run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" }
  ]
}
